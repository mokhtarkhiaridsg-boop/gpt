# Tamkīn — environment configuration
#
# Copy this file to .env.local for local dev, and set these vars in Vercel
# project settings for production. The app builds and runs without them —
# the Ummah Trajectory page falls back to seed values when Supabase is not
# configured.

# Supabase — public project URL and anon key
# Find these in your Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
